[node name="PaperLabel" type="Label" parent="CanvasLayer"]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/normal = SubResource("StyleBoxFlat_pt3ps")
text = "
Hey! Welcome to your first day as the new nightguard,
I'm the previous one. Don't worry too much if you start to hear noises
or if some stuff start to move.. It's nothing to worry about.
Anyways, here is what you need to do:
1. Turn the power on.
2. Visit the Ore Exhibit and make sure nothing is missing.
3. Take the elevator to the next floor and check everything.
4. Do that for every floor.
5. Check on the basement, but stay in the shelter.
6. If anything is wrong, call the police instantly. But don't let it
get on the news.
7. If anything found you, stay calm and quickly make your way to an
exit."
label_settings = SubResource("LabelSettings_hmc15")
horizontal_alignment = 1
autowrap_mode = 2

